datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model PlatformConfig {
  id                       Int      @id @default(1)
  defaultTimePerQ          Int      @default(60)
  negativeMarking          Boolean  @default(false)
  maintenanceMode          Boolean  @default(false)
  vectorBotEnabled         Boolean  @default(true)
  supportEmail             String   @default("support@ecat-cbt.com")
  // Exam settings
  defaultTestSize          Int      @default(40)
  maxPracticeQuestions     Int      @default(100)
  defaultPackage           String   @default("STANDARD")
  // Security & access
  registrationMode         String   @default("Open") // "Open" | "Approval" | "Invite"
  emailVerificationRequired Boolean @default(false)
  autoApproveStudents      Boolean  @default(true)
  freezeThreshold          Int      @default(3)
  updatedAt                DateTime @updatedAt
}

// Singleton configuration for the server-side AI provider. The API key is
// AES-GCM encrypted and is never selected or returned to the frontend.
model AiProviderConfig {
  id               Int      @id @default(1)
  provider         String   @default("groq")
  model            String   @default("openai/gpt-oss-120b")
  apiKeyCiphertext String?  @db.Text
  apiKeyLastFour   String?
  updatedByEmail   String?
  updatedAt        DateTime @updatedAt
}

enum PackageType {
  STANDARD
  PREMIUM
}

model User {
  id                String          @id @default(uuid())
  name              String
  email             String          @unique
  password          String
  role              String          @default("student")
  isApproved        Boolean         @default(false)
  isEmailVerified   Boolean         @default(false)
  isDemoAccount     Boolean         @default(false)
  domain            String?         // e.g., "Engineering", "Medical", "Computer Science"
  cnic              String?         @unique // CNIC - prevents re-registration with same national ID
  emailOtp              String?         // One-time password for email verification
  emailOtpExpiry        DateTime?       // OTP expiry time
  passwordResetToken    String?         // Hashed secure password reset token
  passwordResetExpiry   DateTime?       // Token expiry (1 hour from issue)
  packageType       PackageType     @default(STANDARD)
  testAttemptsLimit Int             @default(0)
  falseReportCount  Int             @default(0)
  frozenUntil       DateTime?
  freezeReason      String?         @db.Text
  hasCompletedOnboarding Boolean    @default(false)
  academicTrack          String?
  academicSubjects       String[]  @default([])
  academicProfileCompleted Boolean @default(false)
  academicProfileEditExpiresAt DateTime?
  selectedUniversities University[]
  selectedExams        EntryExam[]
  attempts          TestAttempt[]   // Relation: User ne kitne tests diye
  tickets           SupportTicket[] // Relation: Support tickets submitted by the user
  createdAt         DateTime        @default(now())
}


// 2. Admin Table (Dedicated admin identity and access controls)
model Admin {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String
  secretHash           String
  secretCode           String?
  rank                 String    @default("Admin")
  isFrozen             Boolean   @default(false)
  passwordResetToken   String?   // Hashed secure password reset token
  passwordResetExpiry  DateTime? // Token expiry (1 hour from issue)
  createdAt            DateTime  @default(now())
}

model LoginMessage {
  id              String   @id @default(uuid())
  recipientEmail  String
  recipientRole   String
  body            String   @db.Text
  senderEmail     String?
  showSenderEmail Boolean  @default(true)
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// 3. Subjects Table (e.g., Physics, Maths)
model Subject {
  id        String    @id @default(uuid())
  name      String    @unique
  chapters  Chapter[]
  createdAt DateTime  @default(now())
}

// 3. Chapters Table (e.g., Matrices, Electrostatics)
model Chapter {
  id        String     @id @default(uuid())
  name      String
  part      String?    // e.g., "part1" or "part2"
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]
  createdAt DateTime   @default(now())
}

// 4. Questions Table
model Question {
  id            String   @id @default(uuid())
  statement     String   @db.Text
  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  options       Option[]
  correctAnswer String   // Sahi option ka text ya id
  explanation   String?  @db.Text
  isApproved    Boolean  @default(true) // Added for AI content review staging workflow
  isFlagged     Boolean  @default(false) // Added for AI Auditor staging workflow
  auditNotes    String?  @db.Text        // Auditor feedback notes for flagged questions
  createdAt     DateTime @default(now())
}

// 5. Options Table (Har question ke 4 options)
model Option {
  id         String   @id @default(uuid())
  text       String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// 6. Test Attempts Table (Sustained SaaS Metrics tracking ke liye)
model TestAttempt {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Float    // Score achieved (could be float due to negative marking)
  totalMarks Int      // Total marks of the test
  breakdown  Json?    // Stores the entire JSON report of the submitted test (details, cot, tips, etc.)
  createdAt  DateTime @default(now())
}

// 7. Resource Group Table
model ResourceGroup {
  id          String         @id @default(uuid())
  name        String
  description String?
  items       ResourceItem[]
  files       ResourceFile[]
  createdAt   DateTime       @default(now())
}

// 8. Resource File Table
model ResourceFile {
  id              String        @id @default(uuid())
  name            String
  type            String        // e.g., "pdf", "word", "image", "file"
  size            String
  uploadDate      String        // e.g., "2026-07-07"
  downloads       Int           @default(0)
  resourceGroupId String
  resourceGroup   ResourceGroup @relation(fields: [resourceGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

// 9. Resource Item Table
model ResourceItem {
  id              String        @id @default(uuid())
  title           String
  points          Int           @default(0)
  resourceGroupId String
  resourceGroup   ResourceGroup @relation(fields: [resourceGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

model ImpersonationLog {
  id        String   @id @default(uuid())
  adminId   String
  studentId String
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String   // Bug, Account, Payment, Other
  description String   @db.Text
  status      String   @default("Pending") // Pending, Replied, Resolved, False
  reply       String?  @db.Text
  thread      Json?    @default("[]")
  isChatOpen  Boolean  @default(false)
  hasUnreadReply Boolean @default(false)
  isFalse     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExamCategory {
  id    String      @id @default(uuid())
  name  String      @unique // e.g., "Engineering", "Medical", "Computer Science"
  tests EntryExam[]
}

model University {
  id          String      @id @default(uuid())
  name        String      @unique // e.g., "NUST", "FAST", "LUMS"
  logoUrl     String?
  location    String?
  status      String      @default("PUBLISHED") // PUBLISHED, ARCHIVED
  tests       EntryExam[]
  users       User[]
  createdAt   DateTime    @default(now())
}

model EntryExam {
  id           String        @id @default(uuid())
  name         String       // e.g., "NUST NET Series 4", "National MDCAT"
  categoryId   String?
  category     ExamCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  universityId String?
  university   University?   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  examDate     DateTime?    // Crucial for the countdown timer
  isActive     Boolean      @default(true) // Kept for backwards compatibility
  status       String        @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  users        User[]
  pattern      TestPattern?
  createdAt    DateTime      @default(now())
}

model TestPattern {
  id              String      @id @default(uuid())
  examId          String      @unique
  exam            EntryExam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  totalMarks      Int         @default(0)
  totalQuestions  Int         @default(0)
  negativeMarking Float       @default(0)
  sections        Json        @default("[]")
  rawPatternText  String?     @db.Text
  pastPapers      Json?       @default("[]") // Stores URLs/paths to past papers
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
