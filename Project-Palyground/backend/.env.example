# ===================================================================
# ECAT-CBT Backend — Environment Variables Template
# ===================================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` file (it is gitignored).
# ===================================================================

# ---- Database ----
# Neon PostgreSQL connection string (use pooled or direct URL with sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Server ----
PORT=8787
# The URL of your deployed frontend (NO trailing slash). Required in production.
FRONTEND_URL=http://localhost:5173
# Allowed origin for CORS. Must match your frontend URL. Required in production
# (falling back to "*" breaks credentialed requests).
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth ----
# IMPORTANT: Generate a strong random secret, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace_with_a_strong_random_secret

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# In production, register this exact callback URL in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# ---- GitHub OAuth (optional) ----
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# In production, register this exact callback URL in GitHub Developer Settings.
GITHUB_REDIRECT_URI=http://localhost:8787/api/auth/github/callback

# ---- Email (Nodemailer / Gmail) ----
EMAIL_USER=your_email@gmail.com
# Use a Gmail App Password (not your account password). Enable 2FA first.
EMAIL_PASS=your_gmail_app_password

# ---- AI Providers (optional) ----
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2
# Required before saving a Groq key in the Admin AI Configuration panel.
# Generate a long random value and keep it secret; it encrypts the saved key.
AI_CONFIG_ENCRYPTION_KEY=replace_with_a_separate_long_random_secret
OPENAI_API_KEY=sk-your_openai_api_key

# ---- Optional ----
# MONGODB_URI=mongodb+srv://user:password@host/dbname

# ---- Manual Bank-Transfer Payment Configuration ----
PAYMENT_BANK_NAME=Meezan Bank Limited
PAYMENT_ACCOUNT_TITLE=Entrace.pk Education Portal
PAYMENT_IBAN=PK42MEZN0001234567890123
PAYMENT_RAAST_ID=03001234567
PAYMENT_SUPPORT_CONTACT=support@entrace.pk
